# App
APP_ENV=development
WAYFINDER_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql+asyncpg://wayfinder:wayfinder@postgres:5432/wayfinder

# Temporal
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=wayfinder-task-queue

# OpenTelemetry / Jaeger
OTEL_SERVICE_NAME=wayfinder
JAEGER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PLANNER_MODE=openai

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
SLACK_DEFAULT_CHANNEL=
SLACK_USE_SOCKET_MODE=true

# Notion
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=
NOTION_TRIP_DATABASE_ID=

# Open travel data
OPEN_TRAVEL_PROVIDER=osm_overpass
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
WIKIVOYAGE_API_URL=https://en.wikivoyage.org/w/api.php
ENABLE_WIKIDATA_ENRICHMENT=false
ENABLE_WIKIVOYAGE_CONTEXT=false
POI_RESULT_LIMIT=30
POI_SEARCH_RADIUS_METERS=15000
OPEN_TRAVEL_CACHE_TTL_DAYS=7
WAYFINDER_USER_AGENT=WayfinderDemo/0.1

# Demo
DEMO_INPUT_MODE=manual
DEMO_FAST_TIMERS=true
